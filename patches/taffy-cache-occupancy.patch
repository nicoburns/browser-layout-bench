+/// Instrumentation (browser-layout-bench cache-occupancy study): process-wide counters of cache
+/// traffic, read with [`cache_counters`] and zeroed with [`reset_cache_counters`].
+pub mod stats {
+    use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+
+    pub(super) static LAYOUT_HITS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static LAYOUT_MISSES: AtomicU64 = AtomicU64::new(0);
+    pub(super) static MEASURE_HITS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static MEASURE_MISSES: AtomicU64 = AtomicU64::new(0);
+    pub(super) static MODE_MISSES: AtomicU64 = AtomicU64::new(0);
+    pub(super) static LAYOUT_STORES: AtomicU64 = AtomicU64::new(0);
+    pub(super) static MEASURE_STORES: AtomicU64 = AtomicU64::new(0);
+    pub(super) static MEASURE_UPDATES: AtomicU64 = AtomicU64::new(0);
+    pub(super) static MEASURE_EVICTIONS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static MEASURE_UNCACHEABLE: AtomicU64 = AtomicU64::new(0);
+    pub(super) static MODE_CHANGE_CLEARS: AtomicU64 = AtomicU64::new(0);
+    pub(super) static CLEARS: AtomicU64 = AtomicU64::new(0);
+
+    #[inline(always)]
+    pub(super) fn bump(counter: &AtomicU64) {
+        counter.fetch_add(1, Relaxed);
+    }
+
+    /// Snapshot of the counters
+    #[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+    pub struct CacheCounters {
+        /// `PerformLayout` requests answered from `final_layout_entry`
+        pub layout_hits: u64,
+        /// `PerformLayout` requests that had to compute (includes requests whose cache mode differed)
+        pub layout_misses: u64,
+        /// `ComputeSize` requests answered from a measure entry
+        pub measure_hits: u64,
+        /// `ComputeSize` requests that had to compute (includes requests whose cache mode differed)
+        pub measure_misses: u64,
+        /// Requests (either mode) rejected because the cache's `CacheMode` differed from the input's
+        pub mode_misses: u64,
+        /// `PerformLayout` results stored
+        pub layout_stores: u64,
+        /// `ComputeSize` results stored into a free (or freshly cleared) slot
+        pub measure_stores: u64,
+        /// `ComputeSize` results that replaced an existing entry with the same key in place
+        pub measure_updates: u64,
+        /// `ComputeSize` results that overwrote a populated slot holding a different key (clock-hand replacement)
+        pub measure_evictions: u64,
+        /// `ComputeSize` results not stored because they carry margin-collapse metadata
+        pub measure_uncacheable: u64,
+        /// Stores into a non-empty cache whose entries were computed with a different `CacheMode` (cache cleared first)
+        pub mode_change_clears: u64,
+        /// `Cache::clear` calls that found entries to clear
+        pub clears: u64,
+    }
+
+    /// Record the outcome of a `compute_cached_layout` lookup (counted at the tree level so that
+    /// nodes without an allocated cache count as misses too)
+    #[inline(always)]
+    pub fn cache_hit_or_miss(run_mode: crate::tree::RunMode, hit: bool) {
+        use crate::tree::RunMode;
+        match (run_mode, hit) {
+            (RunMode::PerformLayout, true) => bump(&LAYOUT_HITS),
+            (RunMode::PerformLayout, false) => bump(&LAYOUT_MISSES),
+            (RunMode::ComputeSize, true) => bump(&MEASURE_HITS),
+            (RunMode::ComputeSize, false) => bump(&MEASURE_MISSES),
+            (RunMode::PerformHiddenLayout, _) => {}
+        }
+    }
+
+    /// Snapshot of the process-wide counters
+    pub fn cache_counters() -> CacheCounters {
+        CacheCounters {
+            layout_hits: LAYOUT_HITS.load(Relaxed),
+            layout_misses: LAYOUT_MISSES.load(Relaxed),
+            measure_hits: MEASURE_HITS.load(Relaxed),
+            measure_misses: MEASURE_MISSES.load(Relaxed),
+            mode_misses: MODE_MISSES.load(Relaxed),
+            layout_stores: LAYOUT_STORES.load(Relaxed),
+            measure_stores: MEASURE_STORES.load(Relaxed),
+            measure_updates: MEASURE_UPDATES.load(Relaxed),
+            measure_evictions: MEASURE_EVICTIONS.load(Relaxed),
+            measure_uncacheable: MEASURE_UNCACHEABLE.load(Relaxed),
+            mode_change_clears: MODE_CHANGE_CLEARS.load(Relaxed),
+            clears: CLEARS.load(Relaxed),
+        }
+    }
+
+    /// Zero the process-wide counters
+    pub fn reset_cache_counters() {
+        for counter in [
+            &LAYOUT_HITS,
+            &LAYOUT_MISSES,
+            &MEASURE_HITS,
+            &MEASURE_MISSES,
+            &MODE_MISSES,
+            &LAYOUT_STORES,
+            &MEASURE_STORES,
+            &MEASURE_UPDATES,
+            &MEASURE_EVICTIONS,
+            &MEASURE_UNCACHEABLE,
+            &MODE_CHANGE_CLEARS,
+            &CLEARS,
+        ] {
+            counter.store(0, Relaxed);
+        }
+    }
+
+    /// Which slots of a [`super::Cache`] hold an entry
+    #[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+    pub struct CacheOccupancy {
+        /// Whether `final_layout_entry` is populated
+        pub final_populated: bool,
+        /// Number of populated `measure_entries` (0..=CACHE_SIZE)
+        pub measure_populated: u8,
+        /// Bitmask of the measure slots marked recently used
+        pub recently_used: u16,
+        /// The clock hand
+        pub next_measure_entry: u8,
+    }
+
+    /// `size_of` the cache and its parts
+    #[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+    pub struct CacheSizes {
+        /// `size_of::<Cache>()`
+        pub cache: usize,
+        /// `size_of::<Option<CacheEntry<LayoutOutput>>>()`
+        pub final_entry: usize,
+        /// `size_of::<Option<CacheEntry<Size<f32>>>>()`
+        pub measure_entry: usize,
+        /// `size_of::<CacheKey>()`
+        pub key: usize,
+        /// `size_of::<LayoutOutput>()`
+        pub layout_output: usize,
+        /// Number of measure slots (`CACHE_SIZE`)
+        pub measure_slots: usize,
+    }
+}
+
+pub use stats::{cache_counters, cache_hit_or_miss, reset_cache_counters, CacheCounters, CacheOccupancy, CacheSizes};
